{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.1",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@mapbox/mapbox-gl-draw": "^1.5.1",
    "@types/mapbox__mapbox-gl-draw": "^1.4.9",
    "firebase": "^12.12.1",
    "lucide-react": "^0.577.0",
    "maplibre-gl": "^5.20.1",
    "zustand": "^5.0.11"
  }
}
